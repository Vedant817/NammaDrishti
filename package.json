{
  "name": "nammadrishti",
  "version": "1.0.0",
  "private": true,
  "description": "NammaDrishti - Real-Time Crowd-Sourced Civic Intelligence, Monsoon Flooding Telemetry & Transit Corridor Radar for Bengaluru",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firebase": "^13.2.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "web-vitals": "^5.0.3"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^6.2.1",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^29.1.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "scripts": {
    "start": "vite --host 127.0.0.1 --port 3000",
    "server": "node server/index.js",
    "doctor": "node scripts/doctor.js",
    "build": "vite build && node scripts/prepare-service-worker.js",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:backend": "node --test server/test/*.test.js",
    "test:live-sources": "node scripts/verify-public-sources.js",
    "test:e2e": "node scripts/simulate_user.js",
    "test:sandbox": "node scripts/sandbox_scenario_runner.js",
    "test:brutal": "node scripts/brutal_stress_runner.js",
    "test:all": "npm run test:ci && npm run test:backend && npm run test:e2e && npm run test:sandbox && npm run test:brutal",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/backup.js restore",
    "test:recovery": "node --test server/test/recovery.test.js",
    "i18n:sync": "node scripts/sync-ui-translations.js"
  },
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.0"
  }
}
