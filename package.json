{
  "name": "nammadrishti",
  "version": "1.0.0",
  "private": true,
  "description": "NammaDrishti - Real-Time Crowd-Sourced Civic Intelligence, Monsoon Flooding Telemetry & Transit Corridor Radar for Bengaluru",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "react-scripts": "5.0.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "web-vitals": "^5.0.3"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "server": "node server/index.js",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "test:ci": "react-scripts test --watchAll=false",
    "test:backend": "node --test server/test/api.test.js",
    "test:e2e": "node scripts/simulate_user.js",
    "test:sandbox": "node scripts/sandbox_scenario_runner.js",
    "test:brutal": "node scripts/brutal_stress_runner.js",
    "test:all": "npm run test:ci && npm run test:backend && npm run test:e2e && npm run test:sandbox && npm run test:brutal",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
