# NammaDrishti — environment variables template.
# Copy to `.env` (frontend, root) and/or set in shell/CI as needed.
# The app is keyless-first: it runs with ZERO of these configured.

# ── Optional frontend build-time overrides (baked into the React bundle) ──
# Custom backend API base (default: http://localhost:5001/api in dev,
# same-origin /api when deployed on a non-localhost host)
# REACT_APP_API_URL=https://api.example.com/api
# Custom WebSocket origin (default: http://localhost:5001 / same origin)
# REACT_APP_SOCKET_URL=wss://api.example.com

# ── Optional server runtime config (server/index.js) ──
# PORT=5001
# Where the backend persists live incidents (defaults to server/incidents.json)
# DATA_FILE=/var/lib/nammadrishti/incidents.json
# Disables Express `trust proxy` in non-production environments
# TRUST_PROXY=false
# Holds back external emergency-dispatch webhooks; used only when configured
# EMERGENCY_DISPATCH_WEBHOOK_URL=

# ── Optional media provider (otherwise optimized inline storage is used) ──
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=

# Firebase mode: enabled by FIREBASE_PROJECT_ID when running server/index.js.
# Leave all Firebase variables unset for local JSON mode. Never commit an Admin key.
# FIREBASE_PROJECT_ID=your-project-id
# GOOGLE_APPLICATION_CREDENTIALS=C:/secure/path/firebase-admin.json
# REACT_APP_FIREBASE_PROJECT_ID=your-project-id
# REACT_APP_FIREBASE_API_KEY=your-public-web-api-key
# REACT_APP_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
# REACT_APP_FIREBASE_APP_ID=your-web-app-id

# Emergency history/socket access: unset disables access in every environment.
# AUTHORITY_TOKEN=use-a-long-random-operator-secret
