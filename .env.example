# Runtime and provider settings
# Local development can omit Firebase. Production requires these settings.
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_APP_ID=
# REACT_APP_API_URL=https://host.example/api
# REACT_APP_SOCKET_URL=https://host.example
# PORT=5001
# TRUST_PROXY=false
# DATA_FILE=/var/lib/nammadrishti/incidents.json
# STATE_DIR=/var/lib/nammadrishti
# MEDIA_DIR=/var/lib/nammadrishti/media
# REQUIRE_VERIFIED_IDENTITY=true
# AUTHORITY_TOKEN=long-random-operator-secret
# GEOCODING_URL=https://nominatim.openstreetmap.org/search
# GEOCODING_USER_AGENT=NammaDrishti/1.0 (operator contact URL)
# TOMTOM_API_KEY=
# GEMINI_API_KEY=
# GEMINI_MODEL=select-an-authorized-model
# FLOOD_OBSERVATIONS_URL=https://authorized-provider.example/observations.json
# EMERGENCY_DISPATCH_WEBHOOK_URL=https://authorized-recipient.example/sos
# EMERGENCY_WEBHOOK_TOKEN=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=https://your-public-domain.example

# Vercel backend only: private runtime credentials, never a REACT_APP variable.
# FIREBASE_SERVICE_ACCOUNT_JSON=
# BLOB_READ_WRITE_TOKEN=
# MEDIA_BLOB_HOST=your-store-id.public.blob.vercel-storage.com
# BACKUP_READ_WRITE_TOKEN=  # separate PRIVATE Blob store; never reuse the public media token
# CRON_SECRET=
# REACT_APP_REALTIME_TRANSPORT=firestore
