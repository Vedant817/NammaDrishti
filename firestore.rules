rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only the server's explicit public projection is readable by signed-in
    // listeners. All writes and private collections remain API/Admin-only.
    match /publicIncidents/{incidentId} {
      allow get: if request.auth != null;
      allow list: if request.auth != null && request.query.limit <= 1000;
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
